<idea-plugin>
    <id>com.sercraft.claudia</id>
    <name>Claudia</name>
    <vendor email="seredniy@gmail.com" url="https://github.com/seredniy/claudia">Sercraft</vendor>

    <description><![CDATA[Claudia is a JetBrains IDE plugin that helps Claude Code users work more efficiently.
<br><br>
<b>Features:</b>
<ul>
<li><b>Session Browser</b> — browse, resume, fork, and delete Claude Code sessions from the right sidebar</li>
<li>Send files and folders to Claude Code terminal with a hotkey</li>
<li>Context menu integration in Project View</li>
<li>Real-time token usage monitoring in status bar</li>
</ul>
<b>Usage:</b>
<ul>
<li>Click the Claudia icon on the right sidebar to open Session Browser</li>
<li>Select file/folder in Project tree → Cmd+Shift+. (or right-click → Send to Claude)</li>
<li>The path will be inserted into the active Claude Code terminal</li>
</ul>]]></description>

    <change-notes><![CDATA[
        <h3>1.0.3</h3>
        <ul>
            <li><b>Session Browser</b> — new tool window on right sidebar to browse, resume, fork, and delete Claude Code sessions</li>
            <li>Search and filter sessions by text or git branch</li>
            <li>Date grouping (Today, Yesterday, This Week, Older)</li>
            <li>Keyboard shortcuts: Enter to resume, Delete to remove session</li>
            <li>Hover highlight and rich tooltip with first prompt, dates, and session ID</li>
            <li>NIO file watcher for automatic session list refresh</li>
            <li>Branch filter popup in toolbar</li>
        </ul>
        <h3>1.0.2</h3>
        <ul>
            <li>Custom Claudia plugin icon</li>
        </ul>
        <h3>1.0.1</h3>
        <ul>
            <li>Send files/folders to Claude Code terminal</li>
            <li>Keyboard shortcut support (Cmd+Shift+.)</li>
            <li>Context menu integration</li>
        </ul>
        <h3>1.0.0</h3>
        <ul>
            <li>Initial release</li>
            <li>Status bar widget with token usage</li>
        </ul>
    ]]></change-notes>

    <!-- Require IntelliJ Platform 2024.2 or later -->
    <idea-version since-build="242"/>

    <!-- Plugin dependencies -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.AnthropicBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-level service for usage tracking -->
        <applicationService
                serviceImplementation="com.example.anthropic.services.AnthropicUsageService"/>

        <!-- Application-level service for settings persistence -->
        <applicationService
                serviceImplementation="com.example.anthropic.settings.AnthropicSettingsState"/>

        <!-- Status bar widget factory -->
        <statusBarWidgetFactory
                id="com.sercraft.claudia.statusbar.widget"
                implementation="com.example.anthropic.statusbar.AnthropicUsageWidgetFactory"
                order="after gitWidget"/>

        <!-- Settings UI -->
        <applicationConfigurable
                parentId="tools"
                instance="com.example.anthropic.settings.AnthropicSettingsConfigurable"
                id="com.sercraft.claudia.settings"
                displayName="Claudia Settings"/>

        <!-- Notification group for usage alerts -->
        <notificationGroup
                id="Anthropic Usage Alerts"
                displayType="BALLOON"
                isLogByDefault="true"/>

        <!-- Project-level service for session management -->
        <projectService
                serviceImplementation="com.example.anthropic.sessions.SessionService"/>

        <!-- Icon mapping for New UI (expui) -->
        <iconMapper mappingFile="IconMappings.json"/>

        <!-- Session Browser tool window on right sidebar -->
        <toolWindow
                id="Claude Sessions"
                anchor="right"
                secondary="false"
                icon="/icons/claudiaSessions.svg"
                factoryClass="com.example.anthropic.sessions.ui.SessionBrowserToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.sercraft.claudia.SendToClaudeAction"
                class="com.example.anthropic.actions.SendToClaudeAction"
                text="Send to Claude"
                icon="AllIcons.Actions.Upload"
                description="Send selected file or folder path to Claude Code terminal">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt PERIOD"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift PERIOD"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift PERIOD"/>
        </action>
    </actions>

    <projectListeners>
        <!-- Listen for project open events to start usage tracking -->
        <listener
                class="com.example.anthropic.services.AnthropicUsageService$ProjectListener"
                topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>
</idea-plugin>
